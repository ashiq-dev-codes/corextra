# https://dart.dev/guides/libraries/private-files
# Created by `dart pub`
.dart_tool/
build/

# Generated by `flutter pub get`.
.flutter-plugins
.flutter-plugins-dependencies

# Avoid committing pubspec.lock for library packages; see
# https://dart.dev/guides/libraries/private-files#pubspeclock.
pubspec.lock

# ...but the example is a runnable app, not a library — commit its lock
# file for reproducible builds.
!/example/pubspec.lock

# Pure Dart package: platform folders here are only ever build leftovers.
/android/
/ios/

# IDE and OS files — never part of the package.
*.iml
.idea/
.DS_Store

# Claude Code local settings
.claude/hooks
.claude/settings.json
.claude/settings.local.json